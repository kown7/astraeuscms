---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="Journal | A Small Site">
  <main class="site-page-main">
    <header class="site-page-intro">
      <p class="site-eyebrow">A SMALL SITE · JOURNAL</p>
      <h1>Journal</h1>
      <p>Notes, ideas, and updates from this little corner of the web.</p>
    </header>
    <ul class="site-post-grid">
      {posts.map((post) => (
        <li class="site-post-card">
          <div class="site-post-meta"><span>JOURNAL</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</time></div>
          <h2><a href={`${baseUrl}journal/${post.data.slug ?? post.id}/`}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  </main>
</Layout>

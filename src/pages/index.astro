---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="A Small Site | Home">
	<section class="site-home-hero">
		<div class="site-hero-content">
			<a class="site-announcement" href={`${baseUrl}journal/`}>
				<span>THE JOURNAL</span>
				<span>Notes and updates <b aria-hidden="true">→</b></span>
			</a>
			<h1>Notes, ideas,<br />and updates.</h1>
			<p>A quiet corner of the web for sharing what’s new and what’s worth remembering.</p>
			<div class="site-hero-actions">
				<a class="site-button site-button-primary" href={`${baseUrl}journal/`}>Explore the journal <span aria-hidden="true">→</span></a>
				<a class="site-button site-button-secondary" href={`${baseUrl}about/`}>About this site</a>
			</div>
		</div>
	</section>
	<main class="site-main">
		<section class="site-recent-section" aria-labelledby="recent-heading">
			<div class="site-section-heading">
				<div><p class="site-eyebrow">FROM THE JOURNAL</p><h2 id="recent-heading">Recent notes</h2></div>
				<a class="site-text-link" href={`${baseUrl}journal/`}>All posts <span aria-hidden="true">→</span></a>
			</div>
			<ul class="site-post-grid">
				{posts.map((post) => (
					<li class="site-post-card">
						<div class="site-post-meta"><span>JOURNAL</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</time></div>
						<h2><a href={`${baseUrl}journal/${post.data.slug ?? post.id}/`}>{post.data.title}</a></h2>
						{post.data.description && <p>{post.data.description}</p>}
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

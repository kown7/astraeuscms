---
import { getEntry } from 'astro:content';

const menu = await getEntry('menus', 'main');
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const menuHref = (href: string) => href.startsWith('/') && !href.startsWith('//') ? `${baseUrl}${href.slice(1)}` : href;
---
<header class="site-header">
	<div class="site-header-inner">
		<a class="site-brand" href={baseUrl} aria-label="A Small Site home">
			<span class="site-brand-mark" aria-hidden="true">A</span>
			<span>A Small Site</span>
		</a>
		{menu && (
			<nav class="site-nav" aria-label={menu.data.title}>
				{menu.data.items.map((item) => <a href={menuHref(item.href)}>{item.label}</a>)}
			</nav>
		)}
		<button class="site-theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme" aria-pressed="false">
			<span data-theme-icon aria-hidden="true">☾</span>
		</button>
	</div>
</header>
